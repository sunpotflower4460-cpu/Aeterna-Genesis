{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeterna-genesis/schemas/campaign.schema.json",
  "title": "Genesis Autopilot campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "title", "hypotheses"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1},
    "parent_room": {"type": "string", "default": "room-g001-a"},
    "model": {"type": "string"},
    "quick": {"type": "boolean", "default": false},
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "min_reached_level": {"type": "integer", "minimum": 0, "maximum": 8, "default": 1},
    "stages": {"$ref": "#/$defs/stages"},
    "approval_required": {"$ref": "#/$defs/approvalStages"},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/hypothesis"}
    }
  },
  "$defs": {
    "knob": {"type": "string", "enum": ["noise_amplitude", "quench_duration"]},
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["2d-screen", "local-3d", "coarse-global-3d", "full-3d"]}
    },
    "approvalStages": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["coarse-global-3d", "full-3d"]}
    },
    "overrides": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "propertyNames": {"$ref": "#/$defs/knob"},
      "additionalProperties": {"type": "number"}
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overrides"],
      "properties": {
        "label": {"type": "string"},
        "overrides": {"$ref": "#/$defs/overrides"}
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variants": {"type": "array", "items": {"$ref": "#/$defs/variant"}},
        "grid": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/knob"},
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "number"}
          }
        }
      },
      "anyOf": [
        {"required": ["variants"]},
        {"required": ["grid"]}
      ]
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "search"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"},
        "statement": {"type": "string", "minLength": 1},
        "search": {"$ref": "#/$defs/search"},
        "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "quick": {"type": "boolean"},
        "min_reached_level": {"type": "integer", "minimum": 0, "maximum": 8},
        "stages": {"$ref": "#/$defs/stages"},
        "approval_required": {"$ref": "#/$defs/approvalStages"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    }
  }
}
